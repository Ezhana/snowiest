---
import type { ImageMetadata } from 'astro'
import { ClientRouter } from 'astro:transitions'
import BaseHead from '../components/site/BaseHead.astro'
import Footer from '../components/site/Footer.astro'
import Header from '../components/site/Header.astro'
import themeBootstrap from '../components/site/theme-bootstrap.js?raw'
import { getLang, type Lang } from '../i18n/ui'

interface Props {
  title: string
  description: string
  image?: ImageMetadata
  /** Absolute canonical URL. Defaults to the current URL. */
  canonical?: string
  /** Absolute URLs per language. Pass an empty object to suppress hreflang entirely. */
  alternates?: Partial<Record<Lang, string>>
}

const { title, description, image, canonical, alternates } = Astro.props
const lang = getLang(Astro.currentLocale)

/**
 * The document shell lives here exactly once: the Ezhana theme, the colour mode and the shared
 * chrome. `data-theme` is server-rendered; the stored preference is replayed before first paint by
 * `components/site/theme-bootstrap.js`, inlined through `?raw` to avoid a flash.
 *
 * `<ClientRouter />` enables Astro view transitions, including the shared-title morph between the
 * blog list and a post. Component scripts therefore run once and use `astro:page-load` for
 * per-navigation setup instead of relying on a full document reload.
 */
---

<html lang={lang} data-theme="cerulean">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      canonical={canonical}
      alternates={alternates}
    />
    <ClientRouter />
    <script is:inline set:html={themeBootstrap}></script>
  </head>
  <body>
    <div
      transition:persist="page-progress"
      class="page-progress"
      data-page-progress
      aria-hidden="true"
    ></div>
    <Header>
      <slot name="header-nav-start" slot="nav-start" />
      <slot name="header-nav-end" slot="nav-end" />
    </Header>
    {/*
      The outline drawer is a top-layer dialog and stays outside the entrance animation. The post
      actions now live inside `main`; `page-enter` deliberately does not fill its final transform so
      they regain the viewport as their fixed containing block once the entrance finishes.
    */}
    <slot name="page-overlays" />
    <div class="page-enter motion-reduce:animate-none">
      <slot />
    </div>
    <Footer />
    <script>
      import { setupPageProgress } from '../components/site/page-progress'
      import { setupDrawers } from '../components/site/drawer'
      import { setupAnchorScroll } from '../lib/anchor-scroll'
      import { setupClientNavigation } from '../lib/client-navigation'

      setupPageProgress()
      setupDrawers()
      setupAnchorScroll()
      setupClientNavigation()
    </script>
  </body>
</html>
