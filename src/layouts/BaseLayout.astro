---
import type { ImageMetadata } from 'astro'
import { ClientRouter } from 'astro:transitions'
import { theme as cerulean } from '@ezhana/design-theme-cerulean'
import BaseHead from '../components/site/BaseHead.astro'
import Footer from '../components/site/Footer.astro'
import GoogleTagManager from '../components/site/GoogleTagManager.astro'
import Header from '../components/site/Header.astro'
import themeBootstrap from '../components/site/theme-bootstrap.js?raw'
import { GTM_IDS } from '../lib/analytics'
import { getLang, useTranslations, type Lang } from '../i18n/ui'

interface Props {
  title: string
  description: string
  image?: ImageMetadata
  /** Absolute canonical URL. Defaults to the current URL. */
  canonical?: string
  /** Absolute URLs per language. Pass an empty object to suppress hreflang entirely. */
  alternates?: Partial<Record<Lang, string>>
  /** Exclude the page from search indexes (used by the 404 page). */
  noindex?: boolean
  /** Locale-less path kept by the header's language switcher; defaults to the current pathname. */
  languagePath?: string
  /** Open Graph page type forwarded to `<BaseHead />`; posts declare `article`. */
  type?: 'website' | 'article'
  /** Article publication / modification times forwarded to `<BaseHead />`. */
  publishedTime?: Date
  modifiedTime?: Date
}

const {
  title,
  description,
  image,
  canonical,
  alternates,
  noindex,
  languagePath,
  type,
  publishedTime,
  modifiedTime,
} = Astro.props
const lang = getLang(Astro.currentLocale)
const t = useTranslations(lang)

/**
 * The document shell lives here exactly once: the Ezhana theme, the colour mode and the shared
 * chrome. `data-theme` is server-rendered; the stored preference is replayed before first paint by
 * `components/site/theme-bootstrap.js`, inlined through `?raw` to avoid a flash.
 *
 * `<ClientRouter />` enables Astro view transitions, including the shared-title morph between the
 * blog list and a post. Component scripts therefore run once and use `astro:page-load` for
 * per-navigation setup instead of relying on a full document reload.
 *
 * Analytics stays out of the way: every GTM loader is `async`, the `<noscript>` fallbacks only exist
 * for non-JS readers, and page views are pushed to `dataLayer` from `lib/analytics.ts`. The whole
 * block is production-only so development traffic never reaches the containers.
 */
---

<html lang={lang} data-theme={cerulean.id}>
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      canonical={canonical}
      alternates={alternates}
      noindex={noindex}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
    />
    <ClientRouter />
    {import.meta.env.PROD && GTM_IDS.map((id) => <GoogleTagManager id={id} />)}
    <script is:inline set:html={themeBootstrap}></script>
  </head>
  <body>
    <a class="skip-link" href="#page-top">
      {t('a11y.skipToContent')}
    </a>
    {import.meta.env.PROD &&
      GTM_IDS.map((id) => (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${id}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
          ></iframe>
        </noscript>
      ))}
    <div
      transition:persist="page-progress"
      class="page-progress"
      data-page-progress
      aria-hidden="true"
    ></div>
    <Header languagePath={languagePath}>
      <slot name="header-nav-start" slot="nav-start" />
      <slot name="header-nav-end" slot="nav-end" />
    </Header>
    {/*
      The outline drawer is a top-layer dialog and stays outside the entrance animation. The post
      actions now live inside `main`; `page-enter` deliberately does not fill its final transform so
      they regain the viewport as their fixed containing block once the entrance finishes.
    */}
    <slot name="page-overlays" />
    <div class="page-enter motion-reduce:animate-none">
      <slot />
    </div>
    <Footer />
    <script>
      import { setupPageProgress } from '../components/site/page-progress'
      import { setupDrawers } from '../components/site/drawer'
      import { setupAnchorScroll } from '../lib/anchor-scroll'
      import { setupAnalytics } from '../lib/analytics'
      import { setupClientNavigation } from '../lib/client-navigation'

      setupPageProgress()
      setupDrawers()
      setupAnchorScroll()
      setupClientNavigation()
      if (import.meta.env.PROD) setupAnalytics()
    </script>
  </body>
</html>
