---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import BaseLayout from './BaseLayout.astro'
import FormattedDate from '../components/FormattedDate.astro'
import { getLang, useTranslations } from '../i18n/ui'

type Props = CollectionEntry<'blog'>['data']

const { title, description, pubDate, updatedDate, heroImage } = Astro.props
const t = useTranslations(getLang(Astro.currentLocale))
---

<BaseLayout title={title} description={description}>
  <main>
    <article class="reading-column ez-editorial">
      {heroImage && <Image class="article-hero" width={1020} height={510} src={heroImage} alt="" />}
      <header class="article-header">
        <p class="article-meta">
          <FormattedDate date={pubDate} />
          {updatedDate && (
            <span class="article-updated">
              {t('post.updated')} <FormattedDate date={updatedDate} />
            </span>
          )}
        </p>
        <h1>{title}</h1>
      </header>
      <slot />
    </article>
  </main>
</BaseLayout>
