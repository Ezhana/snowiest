---
import type { ImageMetadata, MarkdownHeading } from 'astro'
import { Image } from 'astro:assets'
import BaseLayout from './BaseLayout.astro'
import FormattedDate from '../components/FormattedDate.astro'
import TableOfContents from '../components/TableOfContents.astro'
import { getLang, useTranslations } from '../i18n/ui'

interface Props {
  title: string
  description: string
  pubDate?: Date
  updatedDate?: Date
  heroImage?: ImageMetadata
  /** Blog post id, used as the shared view-transition name with the listing title. */
  slug?: string
  headings?: MarkdownHeading[]
}

const { title, description, pubDate, updatedDate, heroImage, slug, headings = [] } = Astro.props
const t = useTranslations(getLang(Astro.currentLocale))

const titleTransitionName = slug ? `post-title-${slug.replace(/[^a-zA-Z0-9_-]/g, '-')}` : undefined
---

<BaseLayout title={title} description={description} image={heroImage}>
  <main class="mx-auto w-full max-w-[72rem] px-4 py-10 lg:py-14">
    <div class="relative mx-auto w-full max-w-[45rem]">
      <article>
        {heroImage && (
          <Image class="article-hero" width={1020} height={510} src={heroImage} alt="" />
        )}
        <header class="article-header">
          {(pubDate || updatedDate) && (
            <p class="article-meta">
              {pubDate && <FormattedDate date={pubDate} />}
              {updatedDate && (
                <span class="article-updated">
                  {t('post.updated')} <FormattedDate date={updatedDate} />
                </span>
              )}
            </p>
          )}
          {titleTransitionName ? (
            <h1 class="text-h1 font-bold text-fg-strong" transition:name={titleTransitionName}>
              {title}
            </h1>
          ) : (
            <h1 class="text-h1 font-bold text-fg-strong">{title}</h1>
          )}
        </header>
        {/* The editorial preset owns rendered prose only; the article shell above is app markup. */}
        <div class="ez-editorial">
          <slot />
        </div>
      </article>
      <TableOfContents headings={headings} label={t('post.toc')} />
    </div>
  </main>
</BaseLayout>
