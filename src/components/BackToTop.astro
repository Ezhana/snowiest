---
/**
 * "Back to top" control, rendered in two places with one behaviour:
 *
 * - `floating`: the round button at the bottom-right of the reading column, from `md` up;
 * - `header`: the quiet icon in the phone header's second row.
 *
 * It is an anchor (`#page-top`) so it still works without JavaScript. The shared `data-scroll-to`
 * handler makes the jump smooth; the script below only owns visibility — revealing every instance
 * after the reader scrolls past a threshold. Each instance keeps its box while hidden so appearing
 * does not move anything around it.
 *
 * This component does not implement the click: `lib/anchor-scroll.ts` owns that for every
 * back-to-top entry and the TOC text link.
 */
interface Props {
  label: string
  variant?: 'floating' | 'header'
  className?: string
}

const { label, variant = 'floating', className } = Astro.props
const isHeader = variant === 'header'
---

<a
  href="#page-top"
  data-scroll-to
  data-back-to-top
  data-visible="false"
  inert
  aria-label={label}
  title={label}
  class:list={[
    'control pointer-events-none inline-flex shrink-0 translate-y-1 items-center justify-center opacity-0 transition duration-300 ease-out motion-reduce:transition-none data-[visible=true]:pointer-events-auto data-[visible=true]:translate-y-0 data-[visible=true]:opacity-100',
    isHeader ? 'size-9' : 'control-raised size-11 rounded-pill',
    className,
  ]}
>
  <svg
    class={isHeader ? 'size-4' : 'size-5'}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 19V5M5 12l7-7 7 7"></path>
  </svg>
</a>

<script>
  import { onPageLoad, onScrollFrame } from '../lib/runtime'

  /** Scroll offsets (px) with a hysteresis gap so the controls do not flicker at the threshold. */
  const SHOW_AFTER = 480
  const HIDE_BEFORE = 360

  let controller: AbortController | null = null

  const setupBackToTop = () => {
    controller?.abort()
    controller = null

    const triggers = Array.from(document.querySelectorAll<HTMLElement>('[data-back-to-top]'))
    if (triggers.length === 0) return

    const activeController = new AbortController()
    controller = activeController

    const update = () => {
      for (const trigger of triggers) {
        const isVisible = trigger.dataset.visible === 'true'
        const nextVisible = window.scrollY > (isVisible ? HIDE_BEFORE : SHOW_AFTER)
        if (nextVisible === isVisible) continue

        trigger.dataset.visible = String(nextVisible)
        // `inert` keeps the hidden control out of the tab order and the accessibility tree.
        trigger.toggleAttribute('inert', !nextVisible)
      }
    }

    update()
    onScrollFrame(update, activeController.signal)
  }

  onPageLoad(setupBackToTop)
</script>
