---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Comment from '../comment/Comment.astro'
import LinkListing from '../links/LinkListing.astro'
import CopyButton from '../site/CopyButton.astro'
import { SITE_LINK_EXCHANGE_URL } from '../../consts'
import { linksCopy } from '../../i18n/pages/links'
import { getLang } from '../../i18n/ui'
import {
  FRIEND_LINK_SLUGS,
  SELF_LINK_SLUG,
  getFriendLinkViews,
  getLinkViews,
} from '../../lib/links'

const lang = getLang(Astro.currentLocale)
const copy = linksCopy[lang]

/**
 * Two sections, no duplicated cards: "all links" carries every non-friend entry, and the curated
 * friend list follows it. The site's own link is part of the friend list and also has a copyable
 * reference panel below it; a missing self link fails the build rather than silently dropping the
 * panel.
 */
const allLinks = await getLinkViews(lang)
const friendLinks = await getFriendLinkViews(lang)
const friendSlugs = new Set<string>(FRIEND_LINK_SLUGS)
const otherLinks = allLinks.filter((link) => !friendSlugs.has(link.slug))

const selfLink = allLinks.find((link) => link.slug === SELF_LINK_SLUG)
if (!selfLink) throw new Error(`Link "${SELF_LINK_SLUG}" is not defined in the links collection.`)

const selfDescription = selfLink.description

/**
 * The copy button writes the card's fields verbatim, one per line. Selecting the card by hand can
 * pick up extra line breaks from the block markup, so the button copies this exact string instead.
 * Labels own their trailing separator (English labels end with a space, Chinese with a full-width
 * colon).
 */
const selfInfoText = [
  `${copy.selfNameLabel}${selfLink.name}`,
  selfLink.icon ? `${copy.selfIconLabel}${selfLink.icon}` : null,
  `${copy.selfLinkLabel}${selfLink.url}`,
  selfDescription ? `${copy.selfDescriptionLabel}${selfDescription}` : null,
]
  .filter((part): part is string => Boolean(part))
  .join('\n')
---

<BaseLayout title={copy.title} description={copy.description}>
  <main id="page-top" tabindex="-1" class="mx-auto w-full max-w-6xl px-4 py-10 lg:py-14">
    <div class="mx-auto w-full max-w-180 space-y-4">
      <div class="space-y-2">
        <h1 class="text-h1 font-bold text-fg-strong">{copy.title}</h1>
        <p class="text-small text-fg-muted">{copy.orderNote}</p>
      </div>
      {otherLinks.length > 0 && (
        <section class="space-y-4" aria-labelledby="all-links-heading">
          <h2 id="all-links-heading" class="text-h2 font-bold text-fg-strong">
            {copy.allLinksHeading}
          </h2>
          <LinkListing links={otherLinks} lang={lang} />
        </section>
      )}

      <section class="space-y-4" aria-labelledby="friend-links-heading">
        <div class="space-y-2">
          <h2 id="friend-links-heading" class="text-h2 font-bold text-fg-strong">
            {copy.friendHeading}
          </h2>
          <p>{copy.intro}</p>
        </div>
        {friendLinks.length > 0 && <LinkListing links={friendLinks} lang={lang} />}

        <p class="text-small text-fg-muted">
          {copy.exchange}{' '}
          <a class="copy-link" href={SITE_LINK_EXCHANGE_URL}>
            {copy.exchangeLink}
          </a>{' '}
          {copy.exchangeTail}
        </p>

        <aside
          class="rounded-surface border border-border bg-bg-subtle p-4"
          aria-labelledby="self-link-heading"
        >
          <div class="flex items-center justify-between gap-2">
            <h3 id="self-link-heading" class="text-small font-semibold text-fg-strong">
              {copy.selfLabel}
            </h3>
            <CopyButton text={selfInfoText} ariaLabel={copy.copyAriaLabel} />
          </div>
          <p class="mt-1 text-small text-fg-muted">{copy.selfNote}</p>
          <dl class="mt-2 space-y-1 text-small">
            <div>
              <dt class="inline text-fg-muted">{copy.selfNameLabel}</dt>
              <dd class="inline font-semibold text-fg-strong">{selfLink.name}</dd>
            </div>
            <div>
              <dt class="inline text-fg-muted">{copy.selfIconLabel}</dt>
              <dd class="inline break-all select-all">{selfLink.icon}</dd>
            </div>
            <div>
              <dt class="inline text-fg-muted">{copy.selfLinkLabel}</dt>
              <dd class="inline break-all select-all">{selfLink.url}</dd>
            </div>
            {selfDescription && (
              <div>
                <dt class="inline text-fg-muted">{copy.selfDescriptionLabel}</dt>
                <dd class="inline text-fg-muted">{selfDescription}</dd>
              </div>
            )}
          </dl>
        </aside>
      </section>
      <div class="mt-12">
        <Comment />
      </div>
    </div>
  </main>
</BaseLayout>
