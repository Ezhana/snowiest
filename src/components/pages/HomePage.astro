---
import BaseLayout from '../../layouts/BaseLayout.astro'
import BlogTimeline from '../timeline/BlogTimeline.astro'
import { homeCopy } from '../../i18n/pages/home'
import { getLang } from '../../i18n/ui'

const lang = getLang(Astro.currentLocale)
const copy = homeCopy[lang]
---

<BaseLayout title={copy.title} description={copy.description}>
  <main id="page-top" tabindex="-1" class="mx-auto w-full max-w-6xl px-4 py-12">
    <section class="mx-auto w-full max-w-180 space-y-4">
      <p class="flex items-center gap-1 text-caption font-semibold uppercase tracking-[0.18em] text-accent">
        <span class="inline-block size-1.5 rounded-full bg-accent" aria-hidden="true"></span>
        {copy.eyebrow}
      </p>
      <div class="space-y-2">
        <h1 class="text-h1 font-bold text-fg-strong">{copy.title}</h1>
        <p class="text-small font-normal text-fg-muted">{copy.lead}</p>
      </div>
      <div class="space-y-2">
        <p class="leading-relaxed" set:html={copy.intro} />
        <p class="leading-relaxed" set:html={copy.contact} />
      </div>
      <p class="text-small text-fg-muted" set:html={copy.about} />
    </section>
    <div class="mx-auto mt-12 w-full max-w-[64rem]">
      <BlogTimeline />
    </div>
  </main>
</BaseLayout>
