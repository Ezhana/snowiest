---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Comment from '../comment/Comment.astro'
import { aboutCopy } from '../../i18n/pages/about'
import { getLang } from '../../i18n/ui'

const lang = getLang(Astro.currentLocale)
const copy = aboutCopy[lang]
---

<BaseLayout title={copy.title} description={copy.description}>
  <main class="mx-auto w-full max-w-6xl px-4 py-10 lg:py-14">
    <div class="mx-auto w-full max-w-180">
      <h1 class="text-center text-h1 font-bold text-fg-strong">{copy.title}</h1>
      <div class="mt-8 space-y-4 leading-relaxed">
        <p set:html={copy.intro} />

        <p>{copy.threeWordsPrompt}</p>

        <br />
        <p class="text-display font-bold text-fg-strong">{copy.threeWords}</p>
        <br />

        <p set:html={copy.fun} />

        <div>
          <p set:html={copy.order} />
          <p class="text-small" set:html={copy.design} />
        </div>

        <p set:html={copy.harmony} />

        <p set:html={copy.closing} />

        <h2 class="text-h2 font-bold text-fg-strong">{copy.siteHeading}</h2>

        <div class="space-y-1">
          <p set:html={copy.siteIntro} />
          <p set:html={copy.updates} />
        </div>

        <h2 class="text-h2 font-bold text-fg-strong">{copy.findMeHeading}</h2>

        <p set:html={copy.findMe} />

        <p class="text-small text-fg-muted" set:html={copy.ps} />
      </div>

      <Comment />
    </div>
  </main>
</BaseLayout>
