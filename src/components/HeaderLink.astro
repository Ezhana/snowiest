---
import type { HTMLAttributes } from 'astro/types'
import { defaultLang, getLang } from '../i18n/ui'

type Props = HTMLAttributes<'a'>

const { href, class: className, ...props } = Astro.props
const lang = getLang(Astro.currentLocale)
const base = import.meta.env.BASE_URL.replace(/\/+$/, '')
const pathname = base === '' ? Astro.url.pathname : Astro.url.pathname.replace(base, '')
const normalize = (path: string) => path.replace(/\/+$/, '') || '/'
const current = normalize(pathname)
const target = normalize(href ?? '/')
const homeTargets = lang === defaultLang ? ['/'] : ['/', `/${lang}`]
const isHome = homeTargets.includes(target)
const isActive = isHome
  ? current === target
  : current === target || current.startsWith(`${target}/`)
---

<a
  href={href}
  aria-current={isActive ? 'page' : undefined}
  class:list={[
    'rounded-control px-3 py-2 text-body font-medium text-fg-muted no-underline transition-colors hover:bg-bg-subtle hover:text-fg-strong aria-[current=page]:bg-bg-subtle aria-[current=page]:font-semibold aria-[current=page]:text-fg-strong md:px-4 md:py-2.5',
    className,
  ]}
  {...props}
>
  <slot />
</a>
