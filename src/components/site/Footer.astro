---
import { getLang, useTranslations } from '../../i18n/ui'
import { TAG_DEFINITIONS } from '../../lib/tags'
import { CONTENT_LICENSE_NAME, CONTENT_LICENSE_URL, SITE_GITHUB_URL, SITE_URL } from '../../consts'
import { atomUrl, rssUrl } from '../../i18n/routing'
import Tag from '../tag/Tag.astro'

const today = new Date()
const lang = getLang(Astro.currentLocale)
const t = useTranslations(lang)
const [licenseBefore, licenseAfter = ''] = t('footer.license').split('{license}')
---

<footer class="border-t border-border px-4 pt-8 pb-8 text-center text-small text-fg-muted">
  <nav
    aria-label={t('blog.tagsLabel')}
    class="mb-6 flex flex-wrap items-center justify-center gap-x-4 gap-y-2"
  >
    {TAG_DEFINITIONS.map((tag) => (
      <Tag className="text-fg-muted" tag={tag.id} lang={lang} interactive />
    ))}
  </nav>
  <p class="m-0">
    &copy; {today.getFullYear()} {t('footer.copyright')}
  </p>
  <p class="m-0 mt-1">
    {licenseBefore}
    <a class="hover:text-accent" href={CONTENT_LICENSE_URL}>
      {CONTENT_LICENSE_NAME}
    </a>
    {licenseAfter}
  </p>
  <div class="mt-3 flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
    <a
      class="inline-flex items-center gap-2 text-fg-muted transition-colors hover:text-fg-strong"
      href={SITE_GITHUB_URL}
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18">
        <path
          fill="currentColor"
          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
        />
      </svg>
      <span>{t('footer.source')}</span>
    </a>
    <a
      class="inline-flex items-center gap-2 text-fg-muted transition-colors hover:text-fg-strong"
      href={SITE_URL}
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        aria-hidden="true"
        width="18"
        height="18"
      >
        <circle cx="12" cy="12" r="10"></circle>
        <path d="M2 12h20"></path>
        <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
      </svg>
      <span>{t('footer.hosted')}</span>
    </a>
    <a
      class="inline-flex items-center gap-2 text-fg-muted transition-colors hover:text-fg-strong"
      href={rssUrl(lang)}
      aria-label={t('rss.label')}
      title={t('rss.label')}
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        width="18"
        height="18"
      >
        <path d="M4 11a9 9 0 0 1 9 9"></path>
        <path d="M4 4a16 16 0 0 1 16 16"></path>
        <circle cx="5" cy="19" r="1"></circle>
      </svg>
      <span>RSS</span>
    </a>
    <a
      class="inline-flex items-center gap-2 text-fg-muted transition-colors hover:text-fg-strong"
      href={atomUrl(lang)}
      aria-label={t('atom.label')}
      title={t('atom.label')}
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        width="18"
        height="18"
      >
        <circle cx="12" cy="12" r="1"></circle>
        <path d="M20.2 20.2c2.04-2.03.02-7.36-4.5-11.9-4.54-4.52-9.87-6.54-11.9-4.5-2.04 2.03-.02 7.36 4.5 11.9 4.54 4.52 9.87 6.54 11.9 4.5Z" />
        <path d="M15.7 15.7c4.52-4.54 6.54-9.87 4.5-11.9-2.03-2.04-7.36-.02-11.9 4.5-4.52 4.54-6.54 9.87-4.5 11.9 2.03 2.04 7.36.02 11.9-4.5Z" />
      </svg>
      <span>Atom</span>
    </a>
  </div>
</footer>
