---
import type { HTMLAttributes } from 'astro/types'
import { defaultLang, getLang } from '../../i18n/ui'
import { stripBase } from '../../i18n/routing'

type Props = HTMLAttributes<'a'>

const { href, class: className, ...props } = Astro.props
const lang = getLang(Astro.currentLocale)
const pathname = stripBase(Astro.url.pathname)
const normalize = (path: string) => path.replace(/\/+$/, '') || '/'
const current = normalize(pathname)
const target = normalize(stripBase(href ?? '/'))
const homeTargets = lang === defaultLang ? ['/'] : ['/', `/${lang}`]
const isHome = homeTargets.includes(target)
const isActive = isHome
  ? current === target
  : current === target || current.startsWith(`${target}/`)
---

<a
  href={href}
  aria-current={isActive ? 'page' : undefined}
  class:list={[
    'control shrink-0 whitespace-nowrap px-2 py-2 text-control font-medium sm:px-3',
    className,
  ]}
  {...props}
>
  <slot />
</a>
