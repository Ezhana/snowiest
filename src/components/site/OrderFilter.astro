---
import { getLang, useTranslations } from '../../i18n/ui'
import { localeUrl } from '../../i18n/routing'

interface Props {
  basePath: string
}

const { basePath } = Astro.props
const lang = getLang(Astro.currentLocale)
const t = useTranslations(lang)
const base = localeUrl(lang, basePath)

const activeClass = 'bg-accent-subtle font-medium text-accent'
const inactiveClass = 'text-fg-muted hover:bg-bg-subtle hover:text-fg-strong active:text-accent'
const options = [
  { order: 'newest', href: base, label: t('order.newest') },
  { order: 'oldest', href: `${base}?order=oldest`, label: t('order.oldest') },
]
---

<nav
  aria-label={t('order.label')}
  class="inline-flex shrink-0 items-center gap-0.5 rounded-control border border-border p-0.5"
>
  {options.map((option) => (
    <a
      href={option.href}
      data-order-link={option.order}
      data-state-active={activeClass}
      data-state-inactive={inactiveClass}
      aria-current={option.order === 'newest' ? 'page' : undefined}
      class:list={[
        'rounded-lg px-2.5 py-1.5 text-small no-underline transition-colors',
        option.order === 'newest' ? activeClass : inactiveClass,
      ]}
    >
      {option.label}
    </a>
  ))}
</nav>
