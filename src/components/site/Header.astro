---
/**
 * Morphing site header.
 *
 * At rest it floats as an inset, rounded glass bar over the page. Once the document scrolls,
 * `data-scrolled` expands it smoothly to full width and strengthens the surface (more opaque,
 * border + shadow). The colour-mode menu is driven by @ezhana/theme, which persists the
 * `system` / `light` / `dark` preference and writes the Ezhana data attributes.
 */
import HeaderLink from './HeaderLink.astro'
import ThemeModeIcon from './ThemeModeIcon.astro'
import { withBase } from '../../consts'
import { getLang, languages, useTranslations, type Lang } from '../../i18n/ui'
import { localeUrl, stripBase, stripLocale } from '../../i18n/routing'

const lang = getLang(Astro.currentLocale)
const t = useTranslations(lang)
const currentPath = stripLocale(stripBase(Astro.url.pathname), lang)

const navItems = [
  { href: localeUrl(lang, '/'), label: t('nav.home') },
  { href: localeUrl(lang, '/blog/'), label: t('nav.blog') },
  { href: localeUrl(lang, '/moment/'), label: t('nav.moment') },
  { href: localeUrl(lang, '/links/'), label: t('nav.links') },
  { href: localeUrl(lang, '/about/'), label: t('nav.about') },
]

const languageOptions = (Object.keys(languages) as Lang[]).map((code) => ({
  code,
  label: languages[code].label,
  href: localeUrl(code, currentPath),
  isCurrent: code === lang,
}))

const themeOptions = [
  { mode: 'system' as const, label: t('theme.system') },
  { mode: 'light' as const, label: t('theme.light') },
  { mode: 'dark' as const, label: t('theme.dark') },
]
---

<header data-site-header data-scrolled="false" class="group sticky top-0 z-50">
  <div class="px-3 pt-3 transition-[padding] duration-500 ease-out group-data-[scrolled=true]:p-0 motion-reduce:transition-none">
    <div class="mx-auto w-full max-w-[60rem] animate-fade-in rounded-panel border border-border/60 bg-bg/55 shadow-md backdrop-blur-xl transition-[max-width,border-radius,border-color,background-color,box-shadow] duration-500 ease-out motion-reduce:transition-none group-data-[scrolled=true]:max-w-full group-data-[scrolled=true]:rounded-none group-data-[scrolled=true]:border-x-0 group-data-[scrolled=true]:border-t-0 group-data-[scrolled=true]:border-border group-data-[scrolled=true]:bg-bg/85 group-data-[scrolled=true]:shadow-sm motion-reduce:animate-none">
      <div class="grid grid-cols-[1fr_auto] items-center gap-x-4 gap-y-1 px-3 py-3 md:grid-cols-[1fr_auto_1fr] md:px-4 md:py-3">
        <a
          href={localeUrl(lang, '/')}
          class="col-start-1 row-start-1 flex animate-fade-in items-center gap-2 justify-self-start text-fg-strong no-underline [animation-delay:60ms] motion-reduce:animate-none"
        >
          <span
            class="grid size-8 shrink-0 place-items-center rounded-control bg-accent-subtle"
            aria-hidden="true"
          >
            <span
              class="block size-8 bg-accent"
              style={`-webkit-mask: url('${withBase('/favicon.svg')}') center / contain no-repeat; mask: url('${withBase('/favicon.svg')}') center / contain no-repeat;`}
            ></span>
          </span>
          <span class="text-body font-bold tracking-tight">{t('site.title')}</span>
        </a>

        <div class="col-span-2 row-start-2 grid grid-cols-[auto_minmax(0,1fr)_auto] animate-fade-in items-center gap-1 [animation-delay:120ms] motion-reduce:animate-none md:col-span-1 md:col-start-2 md:row-start-1 md:block">
          <div class="justify-self-start md:hidden">
            <slot name="nav-start" />
          </div>

          {/*
            On phones the nav may not fit beside the post actions in the second row (five items
            plus two slots). It becomes a horizontal scroller inside its own grid track, so the
            page never gains a horizontal scrollbar; `safe center` keeps the first item reachable
            once the content overflows. From `md` up the slots disappear and centring is exact.
          */}
          <nav
            aria-label={t('nav.primary')}
            class="flex w-full min-w-0 items-center justify-self-center gap-0.5 overflow-x-auto [justify-content:safe_center] [scrollbar-width:none] sm:gap-1 md:w-auto md:overflow-visible [&::-webkit-scrollbar]:hidden"
          >
            {navItems.map((item) => (
              <HeaderLink href={item.href}>{item.label}</HeaderLink>
            ))}
          </nav>

          <div class="justify-self-end md:hidden">
            <slot name="nav-end" />
          </div>
        </div>
        <div class="col-start-2 row-start-1 flex animate-fade-in items-center justify-self-end gap-1 [animation-delay:180ms] motion-reduce:animate-none md:col-start-3">
          <details class="relative" data-menu data-language-menu>
            <summary
              class="inline-flex h-9 min-w-9 cursor-pointer list-none items-center justify-center gap-1.5 rounded-control px-2 text-small font-medium text-fg-muted transition-colors hover:bg-bg-subtle hover:text-fg-strong md:w-auto md:px-2.5 [&::-webkit-details-marker]:hidden"
              aria-label={t('language.label')}
              title={t('language.label')}
            >
              <svg
                class="size-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
                <path d="M2 12h20"></path>
              </svg>
              <span class="hidden text-caption font-semibold uppercase md:inline">
                {languages[lang].short}
              </span>
              <svg
                class="hidden size-3 opacity-60 md:block"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </summary>
            <div
              data-menu-panel
              role="group"
              aria-label={t('language.label')}
              class="absolute end-0 top-full z-50 mt-2 w-40 rounded-panel border border-border bg-surface-elevated p-1 shadow-lg"
            >
              {languageOptions.map((option) => (
                <a
                  href={option.href}
                  hreflang={option.code}
                  lang={option.code}
                  aria-current={option.isCurrent ? 'true' : undefined}
                  class:list={[
                    'flex items-center justify-between gap-2 rounded-small px-2.5 py-1.5 text-small no-underline transition-colors',
                    option.isCurrent
                      ? 'bg-bg-subtle text-fg-strong'
                      : 'text-fg hover:bg-bg-subtle hover:text-fg-strong',
                  ]}
                >
                  <span>{option.label}</span>
                  {option.isCurrent && (
                    <svg
                      class="size-4 text-accent"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M20 6 9 17l-5-5"></path>
                    </svg>
                  )}
                </a>
              ))}
            </div>
          </details>

          <details class="relative" data-menu data-theme-menu>
            <summary
              class="grid size-9 cursor-pointer list-none place-items-center rounded-control text-fg-muted transition-colors hover:bg-bg-subtle hover:text-fg-strong [&::-webkit-details-marker]:hidden"
              aria-label={t('theme.label')}
              title={t('theme.label')}
            >
              <span class="grid place-items-center">
                <ThemeModeIcon mode="system" class="theme-mode-icon size-4" />
                <ThemeModeIcon mode="light" class="theme-mode-icon size-4" />
                <ThemeModeIcon mode="dark" class="theme-mode-icon size-4" />
              </span>
            </summary>
            <div
              data-menu-panel
              role="group"
              aria-label={t('theme.label')}
              class="absolute end-0 top-full z-50 mt-2 w-44 rounded-panel border border-border bg-surface-elevated p-1 shadow-lg"
            >
              {themeOptions.map((option) => (
                <button
                  type="button"
                  data-theme-mode={option.mode}
                  aria-pressed={option.mode === 'system'}
                  class="flex w-full items-center justify-between gap-2 rounded-small px-2.5 py-1.5 text-start text-small text-fg transition-colors hover:bg-bg-subtle hover:text-fg-strong aria-pressed:bg-bg-subtle aria-pressed:text-fg-strong"
                >
                  <span class="flex items-center gap-2 whitespace-nowrap">
                    <ThemeModeIcon mode={option.mode} class="size-4" />
                    {option.label}
                  </span>
                  <svg
                    data-mode-check
                    class="size-4 text-accent"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M20 6 9 17l-5-5"></path>
                  </svg>
                </button>
              ))}
            </div>
          </details>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  import { setupSiteHeader } from './header'

  setupSiteHeader()
</script>
