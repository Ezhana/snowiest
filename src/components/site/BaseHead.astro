---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../../styles/global.css'
import type { ImageMetadata } from 'astro'
import FallbackImage from '../../assets/blog-placeholder-1.jpg'
import { getLang, useTranslations, type Lang } from '../../i18n/ui'
import { atomUrl, localeUrl, rssUrl, stripBase, stripLocale } from '../../i18n/routing'
import { SITE_AUTHOR, SITE_GITHUB_PROFILE_URL, withBase } from '../../consts'

interface Props {
  title: string
  description: string
  image?: ImageMetadata
  /** Absolute canonical URL. Defaults to the current URL. */
  canonical?: string
  /** Absolute URLs per language. An empty object suppresses hreflang entirely. */
  alternates?: Partial<Record<Lang, string>>
  /** Exclude the page from search indexes (used by the 404 page). */
  noindex?: boolean
  /** Open Graph page type; article pages declare `article` and may add times below. */
  type?: 'website' | 'article'
  /** Article publication time, emitted as `article:published_time`. */
  publishedTime?: Date
  /** Article last-modified time, emitted as `article:modified_time`. */
  modifiedTime?: Date
  /** Alt text of the social image; defaults to the page title. */
  imageAlt?: string
}

const lang = getLang(Astro.currentLocale)
const t = useTranslations(lang)
const siteTitle = t('site.title')

const {
  title,
  description,
  image = FallbackImage,
  canonical,
  alternates,
  noindex = false,
  type = 'website',
  publishedTime,
  modifiedTime,
  imageAlt,
} = Astro.props
const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).toString()

// One place builds the document title: pages pass their own title and the site name is appended,
// except on the home page where they are the same string.
const fullTitle = title === siteTitle ? title : `${title} · ${siteTitle}`
const imageURL = new URL(image.src, Astro.url).toString()
const imageAltText = imageAlt ?? title

// Symmetric pages (listings, tags, pagination, static pages) exist in both locales, so their
// hreflang set can be derived from the current path. Posts pass an explicit set because an
// untranslated post only genuinely exists in one language.
const localePath = stripLocale(stripBase(Astro.url.pathname), lang)
const alternateUrls: Partial<Record<Lang, string>> = alternates ?? {
  zh: new URL(localeUrl('zh', localePath), Astro.site).toString(),
  en: new URL(localeUrl('en', localePath), Astro.site).toString(),
}
const hreflangCodes: Record<Lang, string> = { zh: 'zh-CN', en: 'en' }
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
<link rel="icon" href={withBase('/favicon.ico')} />
<link rel="sitemap" href={withBase('/sitemap-index.xml')} />
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${siteTitle} (RSS)`}
  href={new URL(rssUrl(lang), Astro.site)}
/>
<link
  rel="alternate"
  type="application/atom+xml"
  title={`${siteTitle} (Atom)`}
  href={new URL(atomUrl(lang), Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
<meta name="author" content={SITE_AUTHOR} />

<!-- Google Search Console ownership proof for the URL-prefix property. -->
<meta name="google-site-verification" content="9EdlcTvmKZWIJTlqtfRch-bAQGLD7y5SzV9L8qBPIds" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />
{(Object.entries(alternateUrls) as Array<[Lang, string | undefined]>).map(([code, href]) =>
  href ? <link rel="alternate" hreflang={hreflangCodes[code]} href={href} /> : null,
)}
{alternateUrls.zh && <link rel="alternate" hreflang="x-default" href={alternateUrls.zh} />}

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex" />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteTitle} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:alt" content={imageAltText} />
{type === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime.toISOString()} />
)}
{type === 'article' && modifiedTime && (
  <meta property="article:modified_time" content={modifiedTime.toISOString()} />
)}
{type === 'article' && <meta property="article:author" content={SITE_GITHUB_PROFILE_URL} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
<meta name="twitter:image:alt" content={imageAltText} />
