---
import type { Lang } from '../../i18n/ui'
import type { LinkView } from '../../lib/links'
import Tag from '../tag/Tag.astro'

interface Props {
  links: readonly LinkView[]
  lang: Lang
  /** Hide the category marker where the surrounding context already scopes the list to one tag. */
  showTag?: boolean
  /** Friend links whose site does not link back: rendered dimmed and non-interactive. */
  oneWaySlugs?: readonly string[]
}

const { links, lang, showTag = true, oneWaySlugs = [] } = Astro.props
const oneWay = new Set(oneWaySlugs)
---

<ul class="grid gap-3 sm:grid-cols-2">
  {links.map((link) => {
    const isOneWay = oneWay.has(link.slug)
    const cardClass = isOneWay
      ? 'flex h-full flex-col rounded-surface border border-border bg-surface p-4 opacity-60'
      : 'group flex h-full flex-col rounded-surface border border-border bg-surface p-4 no-underline transition-colors hover:border-accent-border hover:bg-bg-subtle'
    const nameClass = isOneWay
      ? 'truncate font-semibold text-fg-muted'
      : 'truncate font-semibold text-fg-strong transition-colors group-hover:text-accent'
    const content = (
      <>
        <span class="flex items-center justify-between gap-3">
          <span class="flex min-w-0 items-center gap-2.5">
            <span class="relative grid size-8 shrink-0 place-items-center overflow-hidden rounded-control bg-accent-subtle">
              {link.icon && (
                <img
                  data-link-icon
                  src={link.icon}
                  alt=""
                  width="32"
                  height="32"
                  loading="lazy"
                  decoding="async"
                  class="absolute inset-0 size-8 object-cover"
                />
              )}
              {/* Broken or missing external icons fall back to the name's first character. */}
              <span
                data-link-icon-fallback
                class="text-small font-semibold text-accent"
                aria-hidden="true"
                hidden={Boolean(link.icon)}
              >
                {link.name.slice(0, 1)}
              </span>
            </span>
            <span class={nameClass}>{link.name}</span>
          </span>
          {showTag && link.tag && (
            <span class="shrink-0 text-caption text-fg-muted">
              <Tag tag={link.tag} lang={lang} />
            </span>
          )}
        </span>
        {link.description && (
          <span class="mt-2 text-small leading-relaxed text-fg-muted">{link.description}</span>
        )}
      </>
    )

    return (
      <li>
        {isOneWay ? (
          <div class={cardClass}>{content}</div>
        ) : (
          <a href={link.url} target="_blank" rel="noopener noreferrer" class={cardClass}>
            {content}
          </a>
        )}
      </li>
    )
  })}
</ul>

<script>
  import { setupLinkIcons } from './link-icon'

  setupLinkIcons()
</script>
