---
import type { Lang } from '../../i18n/ui'
import { SITE_GITHUB_PROFILE_URL } from '../../consts'
import { getLinks } from '../../lib/links'
import LinkListing from './LinkListing.astro'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const links = await getLinks()

const copy = {
  zh: {
    heading: '友情链接',
    intro: '标记了几处世外桃源。',
    orderNote: '以下链接不分先后。',
    exchange: '互通有无？来',
    exchangeLink: 'GitHub',
    exchangeTail: '找我，带上链接和一句介绍。',
  },
  en: {
    heading: 'FriendLinks',
    intro: 'Places I keep coming back to — friends, tools, and sites worth a detour.',
    orderNote: 'Listed below in no particular order.',
    exchange: 'Have a place worth listing? Find me on',
    exchangeLink: 'GitHub',
    exchangeTail: 'with a link and a one-line intro.',
  },
}[lang]
---

<section class="space-y-4" aria-labelledby="links-heading">
  <h2 id="links-heading" class="text-h2 font-bold text-fg-strong">
    {copy.heading}
  </h2>
  <p>{copy.intro}</p>
  <div>
    <p class="mb-1 text-small text-fg-muted">{copy.orderNote}</p>
    {links.length > 0 && <LinkListing links={links} lang={lang} />}
  </div>
  <p class="text-small text-fg-muted">
    {copy.exchange} <a class="copy-link" href={SITE_GITHUB_PROFILE_URL}>{copy.exchangeLink}</a> {copy.exchangeTail}
  </p>
</section>
