---
import BaseLayout from '../../layouts/BaseLayout.astro'
import MomentsFeed from './MomentsFeed.astro'
import OrderFilter from '../site/OrderFilter.astro'
import { getLang, useTranslations } from '../../i18n/ui'

const t = useTranslations(getLang(Astro.currentLocale))
---

<BaseLayout title={t('moment.title')} description={t('moment.intro')}>
  <main id="page-top" tabindex="-1" class="mx-auto w-full max-w-180 px-4 py-12 space-y-4">
    <header class="flex flex-wrap items-center justify-between gap-3 text-center">
      <div class="min-w-0 space-y-2">
        <h1 class="text-start text-h1 font-bold text-fg-strong">{t('moment.title')}</h1>
        <p class="text-small text-fg-muted">{t('moment.intro')}</p>
      </div>
      <OrderFilter basePath="/moment/" />
    </header>
    <MomentsFeed />
  </main>
</BaseLayout>
