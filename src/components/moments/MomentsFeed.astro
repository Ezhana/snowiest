---
import { getLang, useTranslations } from '../../i18n/ui'
import { getRenderedMoments } from '../../lib/moments'
import MomentCard from './MomentCard.astro'

/**
 * Each moment is its own list item; the infinite list reveals the first eight and then four at a
 * time, so screen readers count moments rather than implementation batches.
 */
const INITIAL_MOMENTS = 8
const LOAD_MOMENTS = 4

const lang = getLang(Astro.currentLocale)
const t = useTranslations(lang)
const entries = await getRenderedMoments()
---

{entries.length === 0 ? (
  <p class="text-center text-fg-muted">{t('moment.empty')}</p>
) : (
  <section aria-label={t('moment.title')}>
    <div data-moments-feed data-initial-batches={INITIAL_MOMENTS} data-load-batches={LOAD_MOMENTS}>
      <ol class="m-0 list-none space-y-4 p-0">
        {entries.map(({ moment, Content }) => (
          <li data-infinite-batch>
            <MomentCard moment={moment}>
              <Content />
            </MomentCard>
          </li>
        ))}
      </ol>
      <div class="mt-8 flex justify-center">
        <button
          type="button"
          data-infinite-sentinel
          hidden
          class="control inline-flex items-center justify-center rounded-pill border border-border px-5 py-2 text-small hover:border-accent-border"
        >
          {t('common.loadMore')}
        </button>
      </div>
    </div>
  </section>
)}

<script>
  import { setupMomentsFeed } from './moments-feed'

  setupMomentsFeed()
</script>
