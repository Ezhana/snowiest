---
import type { BlogOrder } from '../lib/blog'
import type { TagId } from '../lib/tags'
import { getLang, useTranslations } from '../i18n/ui'
import { localeUrl } from '../i18n/routing'

interface Props {
  order: BlogOrder
  tag?: TagId
}

const { order, tag } = Astro.props
const lang = getLang(Astro.currentLocale)
const t = useTranslations(lang)

const sortPath = (nextOrder: BlogOrder) => {
  if (tag) {
    return nextOrder === 'oldest' ? `/blog/tag/${tag}/oldest/` : `/blog/tag/${tag}/`
  }

  return nextOrder === 'oldest' ? '/blog/oldest/' : '/blog/'
}

const options: Array<{ order: BlogOrder; path: string; label: string }> = [
  { order: 'newest', path: sortPath('newest'), label: t('blog.sortNewest') },
  { order: 'oldest', path: sortPath('oldest'), label: t('blog.sortOldest') },
]
---

<nav
  aria-label={t('blog.sortLabel')}
  class="inline-flex shrink-0 items-center gap-0.5 rounded-control border border-border p-0.5"
>
  {options.map((option) => (
    <a
      href={localeUrl(lang, option.path)}
      aria-current={option.order === order ? 'page' : undefined}
      class:list={[
        'rounded-lg px-2.5 py-1.5 text-small no-underline transition-colors',
        option.order === order
          ? 'bg-accent-subtle font-medium text-accent'
          : 'text-fg-muted hover:bg-bg-subtle hover:text-fg-strong active:text-accent',
      ]}
    >
      {option.label}
    </a>
  ))}
</nav>
