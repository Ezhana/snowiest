---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import FormattedDate from './FormattedDate.astro'
import BlogFilter from './BlogFilter.astro'
import BlogTagFilter from './BlogTagFilter.astro'
import { getLang, useTranslations } from '../i18n/ui'
import { localeUrl } from '../i18n/routing'
import type { BlogOrder } from '../lib/blog'
import type { TagId } from '../lib/tags'
import { getTagLabel } from '../lib/tags'

interface Props {
  posts: CollectionEntry<'blog'>[]
  order?: BlogOrder
  tag?: TagId
}

const { posts, order = 'newest', tag } = Astro.props
const lang = getLang(Astro.currentLocale)
const t = useTranslations(lang)
const notice = t('blog.notice')

/** Shared view-transition name for the list title → article title morph. */
const titleTransitionName = (id: string) => `post-title-${id.replace(/[^a-zA-Z0-9_-]/g, '-')}`

const postHref = (id: string) => localeUrl(lang, `/blog/${id}/`)
const tagHref = (id: TagId) =>
  localeUrl(lang, order === 'oldest' ? `/blog/tag/${id}/oldest/` : `/blog/tag/${id}/`)
---

<main class="mx-auto w-full max-w-[45rem] px-4 py-12">
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <h1 class="m-0 text-h1 font-bold text-fg-strong">
      {tag ? `${t('blog.tagPrefix')}${getTagLabel(tag, lang)}` : t('blog.title')}
    </h1>
    <BlogFilter order={order} tag={tag} />
  </div>
  <div class="mb-6">
    <BlogTagFilter order={order} activeTag={tag} />
  </div>
  {notice && <p class="m-0 mb-6 text-small text-fg-muted">{notice}</p>}
  <section>
    <ul class="m-0 list-none p-0">
      {posts.map((post) => (
        <li class="group py-4">
          <div class="flex items-start justify-between gap-6">
            <div class="min-w-0 flex-1">
              <h2
                transition:name={titleTransitionName(post.id)}
                class="m-0 text-h3 font-semibold text-fg-strong"
              >
                <a
                  class="text-fg-strong no-underline transition-colors hover:text-accent"
                  href={postHref(post.id)}
                >
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-2 line-clamp-2 text-body text-fg-muted">{post.data.description}</p>
              <div class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-small text-fg-muted">
                <FormattedDate date={post.data.pubDate} />
                {post.data.tags.length > 0 && <span aria-hidden="true">·</span>}
                {post.data.tags.map((tagId) => (
                  <a
                    class="text-fg-muted no-underline transition-colors hover:text-accent"
                    href={tagHref(tagId)}
                  >
                    #{getTagLabel(tagId, lang)}
                  </a>
                ))}
              </div>
            </div>
            {post.data.heroImage && (
              <a
                href={postHref(post.id)}
                tabindex="-1"
                aria-hidden="true"
                class="hidden shrink-0 sm:block"
              >
                <Image
                  class="h-24 w-40 rounded-surface object-cover opacity-70 transition-opacity group-hover:opacity-100"
                  width={320}
                  height={180}
                  src={post.data.heroImage}
                  alt=""
                />
              </a>
            )}
          </div>
        </li>
      ))}
    </ul>
    <slot />
  </section>
</main>
