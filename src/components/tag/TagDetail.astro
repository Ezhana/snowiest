---
import BaseLayout from '../../layouts/BaseLayout.astro'
import BlogPostList from '../blog/BlogPostList.astro'
import BlogTagFilter from './BlogTagFilter.astro'
import LinkListing from '../links/LinkListing.astro'
import MomentCard from '../moments/MomentCard.astro'
import OrderFilter from '../site/OrderFilter.astro'
import Tag from './Tag.astro'
import { renderMoments } from '../../lib/moments'
import { getTagResources } from '../../lib/tag-resources'
import { getTagLabel, type TagId } from '../../lib/tags'
import { getLang, useTranslations } from '../../i18n/ui'

interface Props {
  tag: TagId
}

const { tag } = Astro.props
const lang = getLang(Astro.currentLocale)
const t = useTranslations(lang)
const tagLabel = getTagLabel(tag, lang)
const { posts, links, moments } = await getTagResources(tag, lang)
const renderedMoments = await renderMoments(moments)

const heading = `#${tagLabel}`
const title = `${heading} · ${t('site.title')}`
---

<BaseLayout title={title} description={title}>
  <main data-blog-listing class="mx-auto w-full max-w-180 px-4 py-12">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h1 class="m-0 text-h1 font-bold text-fg-strong">
        <Tag tag={tag} lang={lang} />
      </h1>
      <OrderFilter basePath={`/tag/${tag}/`} />
    </div>
    <div class="mt-4 mb-6">
      <BlogTagFilter activeTag={tag} />
    </div>
    {posts.length > 0 ? (
      <section>
        <BlogPostList posts={posts} />
      </section>
    ) : (
      <p class="m-0 text-small text-fg-muted">{t('tag.noPosts')}</p>
    )}
    {links.length > 0 && (
      <section class="mt-8 space-y-4" aria-labelledby="tag-links-heading">
        <h2 id="tag-links-heading" class="text-h2 font-bold text-fg-strong">
          {t('tag.linksHeading')}
        </h2>
        <LinkListing links={links} lang={lang} showTag={false} />
      </section>
    )}
    {moments.length > 0 && (
      <section class="mt-8 space-y-4" aria-labelledby="tag-moments-heading">
        <h2 id="tag-moments-heading" class="text-h2 font-bold text-fg-strong">
          {t('tag.momentsHeading')}
        </h2>
        <div class="space-y-3">
          {renderedMoments.map(({ moment, Content }) => (
            <MomentCard moment={moment} showTags={false}>
              <Content />
            </MomentCard>
          ))}
        </div>
      </section>
    )}
  </main>
</BaseLayout>

<script>
  import { setupBlogListing } from '../blog/blog-listing'

  setupBlogListing()
</script>
