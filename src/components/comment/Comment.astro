---
import { getLang, useTranslations } from '../../i18n/ui'

const lang = getLang(Astro.currentLocale)
const t = useTranslations(lang)
const giscusLang = lang === 'zh' ? 'zh-CN' : 'en'
const discussionsUrl = 'https://github.com/Ezhana/snowiest/discussions'
---

<section data-giscus-section class="border-t border-border pt-8" aria-label={t('comment.heading')}>
  {/*
    The giscus client script reads these options; `giscus.ts` mounts it so the theme can be
    resolved on the client and the widget can be re-created after each ClientRouter navigation.
    The status and fallback lines are toggled by that script: a blocked or slow giscus.app must not
    leave an empty section behind.
  */}
  <p data-giscus-status hidden role="status" class="m-0 mb-4 text-small text-fg-muted">
    {t('comment.loading')}
  </p>
  <p data-giscus-fallback hidden class="m-0 mb-4 text-small text-fg-muted">
    {t('comment.failed')}{' '}
    <a class="copy-link" href={discussionsUrl} target="_blank" rel="noopener noreferrer">
      {t('comment.openDiscussions')}
    </a>
  </p>
  <div
    data-giscus
    data-repo="Ezhana/snowiest"
    data-repo-id="R_kgDOVtkYpQ"
    data-category="Announcements"
    data-category-id="DIC_kwDOVtkYpc4DLZ8f"
    data-mapping="pathname"
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="top"
    data-lang={giscusLang}
    data-loading="lazy"
  ></div>
  <noscript>
    <p class="m-0 text-small text-fg-muted">
      {t('comment.failed')}{' '}
      <a class="copy-link" href={discussionsUrl} target="_blank" rel="noopener noreferrer">
        {t('comment.openDiscussions')}
      </a>
    </p>
  </noscript>
</section>

<script>
  import { onPageLoad } from '../../lib/runtime'
  import { setupGiscus } from './giscus'

  onPageLoad(setupGiscus)
</script>
