---
import OrderFilter from '../site/OrderFilter.astro'
import BlogPagination from './BlogPagination.astro'
import BlogPostList from './BlogPostList.astro'
import BlogTagFilter from '../tag/BlogTagFilter.astro'
import { BLOG_PAGE_SIZE, type BlogPostSummary } from '../../lib/blog'
import { getLang, useTranslations } from '../../i18n/ui'

interface Props {
  posts: BlogPostSummary[]
}

const { posts } = Astro.props
const lang = getLang(Astro.currentLocale)
const t = useTranslations(lang)
const hasPosts = posts.length > 0
const totalPages = Math.max(1, Math.ceil(posts.length / BLOG_PAGE_SIZE))
const basePath = '/blog/'
---

<main
  id="page-top"
  tabindex="-1"
  data-blog-listing
  data-page-size={BLOG_PAGE_SIZE}
  class="space-y-4 md:space-y-6 lg:space-y-8 mx-auto w-full max-w-180 px-4 py-12"
>
  <header class="space-y-2 md:space-y-3 lg:space-y-4">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h1 class="text-h1 font-bold text-fg-strong">{t('blog.title')}</h1>
      {hasPosts && <OrderFilter basePath={basePath} />}
    </div>
    {hasPosts && <BlogTagFilter />}
  </header>
  {hasPosts ? (
    <BlogPostList posts={posts} />
  ) : (
    <p class="text-small text-fg-muted">{t('blog.empty')}</p>
  )}
  {hasPosts && <BlogPagination totalPages={totalPages} basePath={basePath} />}
</main>

<script>
  import { setupBlogListing } from './blog-listing'

  setupBlogListing()
</script>
