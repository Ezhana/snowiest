---
import { Image } from 'astro:assets'
import FormattedDate from './FormattedDate.astro'
import { postLang, postSlug, type BlogPost } from '../../lib/blog'
import { getTagLabel, type TagId } from '../../lib/tags'
import { postTitleTransitionName } from '../../lib/view-transitions'
import { getLang, languageName, useTranslations } from '../../i18n/ui'
import { localeUrl } from '../../i18n/routing'

interface Props {
  posts: BlogPost[]
}

const { posts } = Astro.props
const lang = getLang(Astro.currentLocale)
const t = useTranslations(lang)

const postHref = (post: BlogPost) => localeUrl(lang, `/blog/${postSlug(post)}/`)
const tagHref = (id: TagId) => localeUrl(lang, `/tag/${id}/`)
---

<ul data-blog-list class="m-0 list-none p-0">
  {posts.map((post) => (
    <li data-post data-date={post.data.pubDate.valueOf()} class="group py-3">
      <div class="flex items-start justify-between gap-4">
        <div class="min-w-0 flex-1">
          <h2
            transition:name={postTitleTransitionName(postSlug(post))}
            class="m-0 text-h3 font-semibold text-fg-strong"
          >
            <a
              class="text-fg-strong no-underline transition-colors hover:text-accent"
              href={postHref(post)}
            >
              {post.data.title}
            </a>
          </h2>
          <p class="mt-2 line-clamp-2 text-body text-fg-muted">{post.data.description}</p>
          <div class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-small text-fg-muted">
            <FormattedDate date={post.data.pubDate} />
            {postLang(post) !== lang && (
              <span
                class="rounded-pill border border-border px-2 py-0.5 text-caption text-fg-muted"
                title={t('blog.originalLanguage')}
              >
                {languageName(postLang(post), lang)}
              </span>
            )}
            {post.data.tags.length > 0 && <span aria-hidden="true">·</span>}
            {post.data.tags.map((tagId) => (
              <a
                class="text-fg-muted transition-colors hover:text-accent hover:underline"
                href={tagHref(tagId)}
              >
                #{getTagLabel(tagId, lang)}
              </a>
            ))}
          </div>
        </div>
        {post.data.heroImage && (
          <a
            href={postHref(post)}
            tabindex="-1"
            aria-hidden="true"
            class="hidden shrink-0 sm:block"
          >
            <Image
              class="h-24 w-40 rounded-surface object-cover opacity-70 transition-opacity group-hover:opacity-100"
              width={320}
              height={180}
              src={post.data.heroImage}
              alt=""
            />
          </a>
        )}
      </div>
    </li>
  ))}
</ul>
