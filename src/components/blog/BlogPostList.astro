---
import { Image } from 'astro:assets'
import DateTime from '../site/DateTime.astro'
import OriginalLanguage from '../site/OriginalLanguage.astro'
import Tag from '../tag/Tag.astro'
import type { BlogPostSummary } from '../../lib/blog'
import { postTitleTransitionName } from '../../lib/view-transitions'
import { getLang } from '../../i18n/ui'
import { localeUrl } from '../../i18n/routing'

interface Props {
  posts: BlogPostSummary[]
}

const { posts } = Astro.props
const lang = getLang(Astro.currentLocale)

const postHref = (post: BlogPostSummary) => localeUrl(lang, `/blog/${post.slug}/`)
---

<ul data-blog-list class="list-none divide-y divide-border-subtle">
  {posts.map((post) => (
    <li data-post data-date={post.pubDate.valueOf()} class="group py-4">
      <div class="flex items-start justify-between gap-4">
        <div class="min-w-0 flex-1">
          <h2
            transition:name={postTitleTransitionName(post.slug)}
            class="m-0 text-h3 font-semibold text-fg-strong"
          >
            <a
              class="text-fg-strong no-underline transition-colors hover:text-accent"
              href={postHref(post)}
            >
              {post.title}
            </a>
          </h2>
          <p class="mt-2 line-clamp-2 text-body text-fg-muted">{post.description}</p>
          <div class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-small text-fg-muted">
            <DateTime date={post.pubDate} />
            <OriginalLanguage lang={post.lang} />
            {post.tags.map((tagId) => (
              <Tag className="text-accent" tag={tagId} lang={lang} interactive />
            ))}
          </div>
        </div>
        {post.heroImage && (
          <a
            href={postHref(post)}
            tabindex="-1"
            aria-hidden="true"
            class="hidden shrink-0 sm:block"
          >
            <Image
              class="h-24 w-40 rounded-surface object-cover opacity-70 transition-opacity group-hover:opacity-100"
              width={320}
              height={180}
              src={post.heroImage}
              alt=""
            />
          </a>
        )}
      </div>
    </li>
  ))}
</ul>
