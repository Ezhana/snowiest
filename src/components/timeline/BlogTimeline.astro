---
import DateTime from '../site/DateTime.astro'
import OriginalLanguage from '../site/OriginalLanguage.astro'
import Tag from '../tag/Tag.astro'
import { getLang, useTranslations } from '../../i18n/ui'
import { localeUrl } from '../../i18n/routing'
import { getBlogPosts, groupBlogPostsByMonth, postLang, postSlug } from '../../lib/blog'
import { postTitleTransitionName } from '../../lib/view-transitions'

const lang = getLang(Astro.currentLocale)
const posts = await getBlogPosts(lang)
const months = groupBlogPostsByMonth(posts)
const t = useTranslations(lang)
---

<section class="mt-12" aria-labelledby="timeline-heading">
  <h2 id="timeline-heading" class="sr-only">
    {t('timeline.label')}
  </h2>
  <div data-home-timeline class="relative mx-auto w-full max-w-[64rem]">
    <div class="absolute inset-y-0 left-4 w-px bg-border md:left-1/2" aria-hidden="true"></div>
    <ol class="m-0 list-none p-0">
      {months.map((month, index) => (
        <li
          data-infinite-batch
          class="relative pb-10 pl-12 md:grid md:grid-cols-2 md:gap-x-20 md:pb-12 md:pl-0"
        >
          <span
            class="absolute left-4 top-1 size-2.5 -translate-x-1/2 rounded-full bg-accent md:left-1/2"
            aria-hidden="true"
          ></span>
          <div
            class:list={[
              'md:row-start-1',
              index % 2 === 0 ? 'md:col-start-2 md:pl-12' : 'md:col-start-1 md:pr-12 md:text-right',
            ]}
          >
            <p class="m-0 text-small font-semibold text-fg-strong">
              <DateTime date={month.date} format="month" />
            </p>
            <ul class="m-0 mt-3 list-none p-0">
              {month.posts.map((post) => (
                <li class="mt-4 first:mt-0">
                  <a
                    class="group block no-underline"
                    href={localeUrl(lang, `/blog/${postSlug(post)}/`)}
                  >
                    <h3
                      transition:name={postTitleTransitionName(postSlug(post))}
                      class="m-0 text-body font-medium text-fg-strong transition-colors group-hover:text-accent"
                    >
                      {post.data.title}
                    </h3>
                  </a>
                  <p
                    class:list={[
                      'mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-small text-fg-muted',
                      index % 2 === 0 ? 'md:justify-start' : 'md:justify-end',
                    ]}
                  >
                    <DateTime date={post.data.pubDate} />
                    <OriginalLanguage lang={postLang(post)} />
                    {post.data.tags.map((tagId) => (
                      <Tag tag={tagId} lang={lang} />
                    ))}
                  </p>
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))}
    </ol>
    <div class="mt-2 flex justify-center">
      <button
        type="button"
        data-infinite-sentinel
        hidden
        class="inline-flex items-center justify-center rounded-control border border-border px-4 py-2 text-small text-fg-muted transition-colors hover:bg-bg-subtle hover:text-fg-strong"
      >
        {t('common.loadMore')}
      </button>
    </div>
  </div>
</section>

<script>
  import { setupInfiniteList } from '../../lib/infinite-list'

  setupInfiniteList('[data-home-timeline]')
</script>
