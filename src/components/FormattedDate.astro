---
import { getLang } from '../i18n/ui'

interface Props {
  date: Date
}

const { date } = Astro.props
const locale = getLang(Astro.currentLocale) === 'zh' ? 'zh-CN' : 'en-US'
---

<time datetime={date.toISOString()}>
  {date.toLocaleDateString(locale, {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  })}
</time>
