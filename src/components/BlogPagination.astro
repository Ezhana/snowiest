---
import { getLang, useTranslations } from '../i18n/ui'
import { localeUrl } from '../i18n/routing'

interface Props {
  totalPages: number
  basePath: string
}

const { totalPages, basePath } = Astro.props
const lang = getLang(Astro.currentLocale)
const t = useTranslations(lang)
const base = localeUrl(lang, basePath)

const pageHref = (page: number) => (page <= 1 ? base : `${base}?page=${page}`)
const pages = Array.from({ length: totalPages }, (_, index) => index + 1)

const activeClass = 'bg-accent-subtle font-semibold text-accent'
const inactiveClass = 'text-fg-muted hover:bg-bg-subtle hover:text-fg-strong active:text-accent'
const controlClass =
  'inline-flex h-9 items-center justify-center rounded-control px-3 text-small no-underline transition-colors'
const pageClass =
  'inline-flex h-9 min-w-9 items-center justify-center rounded-control px-2 text-small no-underline transition-colors'
---

<!-- Hidden until the listing script applies the query-string state; without it every post is shown. -->
<nav
  data-blog-pagination
  data-base={base}
  aria-label={t('pagination.label')}
  class="mt-6 flex flex-wrap items-center justify-center gap-1.5"
  hidden
>
  <a
    data-pagination-prev
    rel="prev"
    href={base}
    class:list={[controlClass, 'text-fg-muted hover:bg-bg-subtle hover:text-fg-strong']}
  >
    {t('pagination.previous')}
  </a>

  <ul class="m-0 flex list-none flex-wrap items-center justify-center gap-1 p-0">
    {pages.map((page) => (
      <li data-pagination-page data-page={page} hidden={page !== 1}>
        <a
          href={pageHref(page)}
          aria-current={page === 1 ? 'page' : undefined}
          aria-label={`${t('pagination.page')} ${page}`}
          data-state-active={activeClass}
          data-state-inactive={inactiveClass}
          class:list={[pageClass, page === 1 ? activeClass : inactiveClass]}
        >
          {page}
        </a>
      </li>
    ))}
  </ul>

  <a
    data-pagination-next
    rel="next"
    href={pageHref(2)}
    class:list={[controlClass, 'text-fg-muted hover:bg-bg-subtle hover:text-fg-strong']}
  >
    {t('pagination.next')}
  </a>
</nav>
