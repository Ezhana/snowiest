---
import type { BlogOrder } from '../lib/blog'
import type { TagId } from '../lib/tags'
import { TAG_DEFINITIONS, getTagLabel } from '../lib/tags'
import { getLang, useTranslations } from '../i18n/ui'
import { localeUrl } from '../i18n/routing'

interface Props {
  order: BlogOrder
  activeTag?: TagId
}

const { order, activeTag } = Astro.props
const lang = getLang(Astro.currentLocale)
const t = useTranslations(lang)

const tagPath = (tag: TagId) =>
  order === 'oldest' ? `/blog/tag/${tag}/oldest/` : `/blog/tag/${tag}/`
const allPath = order === 'oldest' ? '/blog/oldest/' : '/blog/'

const chipClass = 'rounded-pill border px-3 py-1 text-small no-underline transition-colors'
---

<nav aria-label={t('blog.tagsLabel')} class="flex flex-wrap items-center gap-2">
  <a
    href={localeUrl(lang, allPath)}
    aria-current={activeTag ? undefined : 'page'}
    class:list={[
      chipClass,
      activeTag
        ? 'border-border text-fg-muted hover:bg-bg-subtle hover:text-fg-strong'
        : 'border-accent/40 bg-accent-subtle font-medium text-accent',
    ]}
  >
    {t('blog.allTags')}
  </a>
  {TAG_DEFINITIONS.map((tag) => (
    <a
      href={localeUrl(lang, tagPath(tag.id))}
      aria-current={activeTag === tag.id ? 'page' : undefined}
      class:list={[
        chipClass,
        activeTag === tag.id
          ? 'border-accent/40 bg-accent-subtle font-medium text-accent'
          : 'border-border text-fg-muted hover:bg-bg-subtle hover:text-fg-strong',
      ]}
    >
      {getTagLabel(tag.id, lang)}
    </a>
  ))}
</nav>
