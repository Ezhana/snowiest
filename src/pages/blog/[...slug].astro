---
import { type CollectionEntry, render } from 'astro:content'
import BlogPost from '../../layouts/BlogPost.astro'
import { getAllBlogPosts, getBlogPosts, postLang, postSlug, toBlogPostDetail } from '../../lib/blog'

export async function getStaticPaths() {
  const [posts, allPosts] = await Promise.all([getBlogPosts('zh'), getAllBlogPosts()])
  const langsBySlug = new Map<string, Set<string>>()

  for (const post of allPosts) {
    const slug = postSlug(post)
    const langs = langsBySlug.get(slug) ?? new Set<string>()
    langs.add(postLang(post))
    langsBySlug.set(slug, langs)
  }

  return posts.map((post) => {
    const slug = postSlug(post)
    const langs = langsBySlug.get(slug)

    return {
      params: { slug },
      props: { post, hasTranslation: Boolean(langs?.has('zh') && langs.has('en')) },
    }
  })
}

interface Props {
  post: CollectionEntry<'blog'>
  hasTranslation: boolean
}

const { post, hasTranslation } = Astro.props
const { Content, headings } = await render(post)
---

<BlogPost {...toBlogPostDetail(post)} hasTranslation={hasTranslation} headings={headings}>
  <Content />
</BlogPost>
