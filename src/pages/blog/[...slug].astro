---
import { render } from 'astro:content'
import BlogPost from '../../layouts/BlogPost.astro'
import { getBlogPostStaticPaths, toBlogPostDetail, type BlogPostRouteProps } from '../../lib/blog'

export const getStaticPaths = () => getBlogPostStaticPaths('zh')

type Props = BlogPostRouteProps

const { post, hasTranslation } = Astro.props
const { Content, headings } = await render(post)
---

<BlogPost {...toBlogPostDetail(post)} hasTranslation={hasTranslation} headings={headings}>
  <Content />
</BlogPost>
