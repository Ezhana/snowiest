---
import BlogIndex from '../../../../components/BlogIndex.astro'
import { getBlogPagePaths, getBlogPosts } from '../../../../lib/blog'

export async function getStaticPaths() {
  const posts = await getBlogPosts()
  return getBlogPagePaths(posts.length)
}

interface Props {
  page: number
}

const { page } = Astro.props
---

<BlogIndex page={page} order="oldest" />
