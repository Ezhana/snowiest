---
import BaseLayout from '../../layouts/BaseLayout.astro'
import BlogTimeline from '../../components/BlogTimeline.astro'
import { localeUrl, rssUrl } from '../../i18n/routing'
import { SITE_DESCRIPTION, SITE_GITHUB_PROFILE_URL, SITE_TITLE } from '../../consts'
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <main class="mx-auto w-full max-w-6xl px-4 py-12">
    <section class="mx-auto w-full max-w-180 space-y-4">
      <p class="flex items-center gap-2 text-caption font-semibold uppercase tracking-[0.18em] text-accent">
        <span class="inline-block size-1.5 rounded-full bg-accent" aria-hidden="true"></span>
        Snowiest
      </p>
      <div class="space-y-2">
        <h1 class="text-h1 font-bold text-fg-strong">{SITE_TITLE}</h1>
        <p class="text-h2 text-fg-muted">
          When snow falls, the world goes quiet. This is where I keep the words.
        </p>
      </div>
      <div class="space-y-2">
        <p class="leading-relaxed">
          I'm <strong>Ezhana</strong>. This site shares tech articles, and also collects rants,
          anecdotes, ACGN news, and thoughts that arrive without a plan.
        </p>
        <p
          class="leading-relaxed"
          set:html={`No promise of a schedule, but plenty of room for conversation. Come talk, or just sit by the window for a while. For quiet reading, subscribe to the <a class="copy-link" href="${rssUrl('en')}">RSS feed</a>; to say hello, find me on <a class="copy-link" href="${SITE_GITHUB_PROFILE_URL}">GitHub</a>.`}
        />
      </div>
      <p class="text-small text-fg-muted">
        Want to know who's behind this?{' '}
        <a class="copy-link" href={localeUrl('en', '/about/')}>
          About the author
        </a>
        .
      </p>
    </section>
    <BlogTimeline />
  </main>
</BaseLayout>
