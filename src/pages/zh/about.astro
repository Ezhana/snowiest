---
import Layout from '../../layouts/BlogPost.astro'
import { SITE_AUTHOR, SITE_GITHUB_URL, SITE_TITLE_ZH, SITE_URL } from '../../consts'
---

<Layout title="关于" description={`关于${SITE_TITLE_ZH}与它的作者 ${SITE_AUTHOR}。`}>
  <p>
    <strong>{SITE_TITLE_ZH}</strong>（Snowiest）是 {SITE_AUTHOR} 的个人站点。
  </p>
  <p>
    源码托管在 <a href={SITE_GITHUB_URL}>GitHub</a>，站点使用
    <a href="https://astro.build/">Astro</a> 构建，并通过
    <a href={SITE_URL}>GitHub Pages</a> 发布。
  </p>
</Layout>
