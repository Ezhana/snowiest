    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.5",
    "@ezhana/design-theme-cerulean": "^2.0.0",
    "@ezhana/theme": "^1.0.0",
    "@ezhana/typography-editorial": "^0.2.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.12",
    "feed": "^6.0.0",
    "sharp": "^0.35.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@ezhana/eslint-config-astro": "^0.2.0",
    "@ezhana/prettier-config": "^0.2.0",
    "eslint": "10.10.0",
    "prettier": "3.10.1",
